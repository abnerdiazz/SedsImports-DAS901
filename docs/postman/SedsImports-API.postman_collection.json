{
  "info": {
    "name": "SED's Imports & Services · API (Fase 4)",
    "description": "Colección de pruebas de la API REST. Ejecuta primero 'Iniciar sesión (dueño)': guarda el token en la variable {{token}} y las demás peticiones lo usan automáticamente. Puedes ejecutar toda la colección con Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "api",
      "value": "https://localhost:7181"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "vehiculoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Iniciar sesión (dueño)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/api/auth/login",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ernesto.rivas@sedimports.com\",\n  \"contrasena\": \"Seds2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('Devuelve el token', () => pm.expect(datos.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Credenciales incorrectas → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/api/auth/login",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ernesto.rivas@sedimports.com\",\n  \"contrasena\": \"incorrecta1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Correo no válido → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/api/auth/login",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"no-es-correo\",\n  \"contrasena\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Perfil con token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/api/auth/perfil",
              "host": [
                "{{api}}"
              ],
