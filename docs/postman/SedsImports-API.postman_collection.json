          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(v => pm.expect(v.estado).to.eql('Disponible'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar vehículo → 201",
          "request": {
            "method": "POST",
            "header": [
