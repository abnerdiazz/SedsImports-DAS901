{
  "ConnectionStrings": {
    "SedsImportsDB": "Server=(localdb)\\MSSQLLocalDB;Database=SedsImportsDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Emisor": "SedsImports.Api",
    "Audiencia": "SedsImports.Clientes",
    "Clave": "",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "https://localhost:7180", "http://localhost:5180" ]
  },
  "Swagger": {
    "Habilitado": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
