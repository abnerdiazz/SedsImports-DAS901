<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API REST del sistema (Fase 4) con autenticación JWT y ASP.NET Core Identity.
       Reutiliza las capas de aplicación e infraestructura de la Fase 3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SedsImports.Api</RootNamespace>
    <AssemblyName>SedsImports.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SedsImports.Application\SedsImports.Application.csproj" />
    <ProjectReference Include="..\SedsImports.Infrastructure\SedsImports.Infrastructure.csproj" />
  </ItemGroup>

</Project>
