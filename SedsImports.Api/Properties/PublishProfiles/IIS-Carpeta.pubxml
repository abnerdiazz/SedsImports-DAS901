<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil de publicación para IIS: genera la aplicación compilada (Release) en una carpeta lista
     para el sitio de IIS. En Visual Studio: clic derecho en el proyecto > Publicar > IIS-Carpeta. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishUrl>C:\inetpub\SedsImports\Api</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>
</Project>
